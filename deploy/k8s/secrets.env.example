# Template for the pregao-secrets Secret.
#
#   cp deploy/k8s/secrets.env.example deploy/k8s/.env.prod
#
# .env.prod is gitignored. Never commit real values.
# Write values bare: quotes are NOT stripped and would become part of the value.

# URL-encode special characters in the password (@ -> %40, / -> %2F, ...).
# Keep search_path=pregao. Use sslmode=disable only if the server has no TLS.
DATABASE_URL=postgres://pregao_user:CHANGE_ME@postgres-service.infra.svc.cluster.local:5432/bolsa?sslmode=require&search_path=pregao

# OpenBao token allowed to decrypt with the transit key named by
# OPENBAO_TRANSIT_KEY in configmap.yaml.
OPENBAO_TOKEN=CHANGE_ME

# Optional. Uncomment only if Redis requires a password.
# REDIS_PASSWORD=CHANGE_ME
